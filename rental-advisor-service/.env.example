# URL of the deployed (or local) Apartment Service. No trailing slash.
APARTMENT_SERVICE_URL=http://localhost:5001
PORT=5002
# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173
# Seconds to wait for the Apartment Service (free hosts may need time to wake up)
REQUEST_TIMEOUT=25
# OPTIONAL: own database for saved searches (can be the same Atlas cluster as the Apartment Service)
MONGO_URI=mongodb://localhost:27017
DB_NAME=rentwise_advisor_db
